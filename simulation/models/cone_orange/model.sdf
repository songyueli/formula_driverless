<?xml version="1.0" ?>
<!--
  Orange "big" cone — start/finish gate marker. FS-standard big-cone
  dimensions (placeholder): 0.1425m base radius, 0.505m tall.
-->
<sdf version="1.11">
  <model name="cone_orange">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry>
          <cone><radius>0.1425</radius><length>0.505</length></cone>
        </geometry>
        <material>
          <ambient>0.9 0.35 0 1</ambient>
          <diffuse>0.9 0.35 0 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cone><radius>0.1425</radius><length>0.505</length></cone>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
