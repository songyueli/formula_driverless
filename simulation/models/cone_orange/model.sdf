<?xml version="1.0" ?>
<!-- Orange "big" cone — start/finish gate marker. Dimensions confirmed against FS Driverless Specification 2026, Table 1 "Cone specs": big orange cone base 285mm, height 505mm \-\- 0.1425m base radius (285/2), 0.505m tall. -->
<sdf version="1.11">
  <model name="cone_orange">
    <static>true</static>
    <link name="link">
      
      <!-- ORANGE CONE BODY -->
      <visual name="visual">
        <geometry>
          <cone><radius>0.1425</radius><length>0.505</length></cone>
        </geometry>
        <material>
          <ambient>1 0.35 0 1</ambient>
          <diffuse>1 0.35 0 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
          <emissive>0.4 0.02 0 1</emissive>
          <pbr>
            <metal>
              <roughness>0.1</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- LOWER WHITE STRIPE -->
      <visual name="stripe_lower">
        <pose>0 0 -0.1212 0 0 0</pose>
        <geometry>
          <mesh><uri>meshes/stripe_lower.obj</uri></mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
          <emissive>0.45 0.45 0.45 1</emissive>
          <pbr>
            <metal>
              <roughness>0.1</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- UPPER WHITE STRIPE -->
      <visual name="stripe_upper">
        <pose>0 0 0.0303 0 0 0</pose>
        <geometry>
          <mesh><uri>meshes/stripe_upper.obj</uri></mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
          <emissive>0.45 0.45 0.45 1</emissive>
          <pbr>
            <metal>
              <roughness>0.1</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <cone><radius>0.1425</radius><length>0.505</length></cone>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
