<?xml version="1.0" ?>
<!--
  FSD race car model.
  Step 2: basic car with AckermannSteering (no sensors) — drive manually.
  Step 3: add lidar and cameras (sensor blocks are stubbed below).

  All TODO values must be filled in from real car measurements before this
  model will behave correctly. See project brief section 5 & 6.
-->
<sdf version="1.10">
  <model name="fsd_car">

    <!-- ================================================================
         CHASSIS
         TODO: set mass, moments of inertia from real car specs
         ================================================================ -->
    <link name="chassis">
      <inertial>
        <mass>230</mass>           <!-- kg, total vehicle mass (placeholder, FS-typical) -->
        <inertia>
          <ixx>6.52</ixx>          <!-- kg·m², roll -->
          <iyy>63.8</iyy>          <!-- kg·m², pitch -->
          <izz>66.9</izz>          <!-- kg·m², yaw -->
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="chassis_visual">
        <!-- TODO: replace box with a proper mesh once CAD is available -->
        <geometry>
          <box><size>1.8 0.5 0.3</size></box>  <!-- length width height, meters -->
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="chassis_collision">
        <geometry>
          <box><size>1.8 0.5 0.3</size></box>
        </geometry>
      </collision>

      <!-- ================================================================
           SENSORS (lidar + 3 cameras) — deferred to Step 3, disabled below.
           SDF fails to parse the *entire* file if any single element has an
           invalid value, even one nothing currently depends on — so these
           can't be left in as live elements with TODO pose/FOV values.
           Re-enable (uncomment) and fill in real values in Step 3:
             LIDAR        — Ouster OS1-128, fully parameterized already,
                             just needs <pose> set to the mounting position.
             camera_front — needs <pose> and <horizontal_fov> from lens spec.
             camera_left  — needs <pose> (yaw rotated to face left) and FOV.
             camera_right — needs <pose> (yaw rotated to face right) and FOV.

      <sensor name="os1_128" type="gpu_lidar">
        <pose>TODO TODO TODO 0 0 0</pose>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>1024</samples>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>128</samples>
              <min_angle>-0.3927</min_angle>
              <max_angle>0.3927</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.3</min>
            <max>120.0</max>
          </range>
          <noise>
            <type>gaussian</type>
            <stddev>0.008</stddev>
          </noise>
        </lidar>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>/lidar/points</topic>
      </sensor>

      <sensor name="camera_front" type="camera">
        <pose>TODO TODO TODO 0 0 0</pose>
        <update_rate>30</update_rate>
        <camera>
          <image>
            <width>1440</width>
            <height>1080</height>
          </image>
          <horizontal_fov>TODO</horizontal_fov>
        </camera>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>/camera/front/image</topic>
      </sensor>

      <sensor name="camera_left" type="camera">
        <pose>TODO TODO TODO 0 0 TODO</pose>
        <update_rate>30</update_rate>
        <camera>
          <image>
            <width>1440</width>
            <height>1080</height>
          </image>
          <horizontal_fov>TODO</horizontal_fov>
        </camera>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>/camera/left/image</topic>
      </sensor>

      <sensor name="camera_right" type="camera">
        <pose>TODO TODO TODO 0 0 TODO</pose>
        <update_rate>30</update_rate>
        <camera>
          <image>
            <width>1440</width>
            <height>1080</height>
          </image>
          <horizontal_fov>TODO</horizontal_fov>
        </camera>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>/camera/right/image</topic>
      </sensor>
      -->

    </link> <!-- chassis -->


    <!-- ================================================================
         WHEELS — 4x (AWD, Ackermann front steering)
         ================================================================ -->

    <!-- ================================================================
         FRONT WHEELS — steering knuckle (steer, about z) + wheel (spin, about y).
         Two DOF per front wheel needs an intermediate body between the
         steering joint and the spin joint; a single link can't have both.
         ================================================================ -->

    <!-- Front-left -->
    <joint name="front_left_wheel_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_left_steering_knuckle</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.332</lower>   <!-- negative of steering_limit, radians -->
          <upper>0.332</upper>    <!-- steering_limit, radians -->
          <effort>1e6</effort>    <!-- DART only enforces position limits under
                                        velocity control if an effort limit is set -->
        </limit>
      </axis>
      <pose>0.775 0.6 -0.05 0 0 0</pose>
    </joint>

    <link name="front_left_steering_knuckle">
      <inertial>
        <mass>1</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
    </link>

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steering_knuckle</parent>
      <child>front_left_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>

    <link name="front_left_wheel">
      <inertial>
        <mass>5</mass>
        <inertia><ixx>0.098</ixx><iyy>0.169</iyy><izz>0.098</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="visual"><geometry><cylinder><radius>0.26</radius><length>0.18</length></cylinder></geometry></visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.26</radius><length>0.18</length></cylinder></geometry>
        <surface><friction><ode>
          <mu>1.5</mu>    <!-- longitudinal grip -->
          <mu2>1.5</mu2>  <!-- lateral grip -->
        </ode></friction></surface>
      </collision>
    </link>

    <!-- Front-right (mirror of front-left, y flipped) -->
    <joint name="front_right_wheel_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_right_steering_knuckle</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.332</lower>
          <upper>0.332</upper>
          <effort>1e6</effort>
        </limit>
      </axis>
      <pose>0.775 -0.6 -0.05 0 0 0</pose>
    </joint>

    <link name="front_right_steering_knuckle">
      <inertial>
        <mass>1</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
    </link>

    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steering_knuckle</parent>
      <child>front_right_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>

    <link name="front_right_wheel">
      <inertial>
        <mass>5</mass>
        <inertia><ixx>0.098</ixx><iyy>0.169</iyy><izz>0.098</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="visual"><geometry><cylinder><radius>0.26</radius><length>0.18</length></cylinder></geometry></visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.26</radius><length>0.18</length></cylinder></geometry>
        <surface><friction><ode>
          <mu>1.5</mu>
          <mu2>1.5</mu2>
        </ode></friction></surface>
      </collision>
    </link>

    <!-- ================================================================
         REAR WHEELS — spin only (no steering), attach straight to chassis.
         ================================================================ -->

    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_left_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
      <pose>-0.775 0.6 -0.05 0 0 0</pose>
    </joint>

    <link name="rear_left_wheel">
      <inertial>
        <mass>5</mass>
        <inertia><ixx>0.098</ixx><iyy>0.169</iyy><izz>0.098</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="visual"><geometry><cylinder><radius>0.26</radius><length>0.18</length></cylinder></geometry></visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.26</radius><length>0.18</length></cylinder></geometry>
        <surface><friction><ode>
          <mu>1.5</mu>
          <mu2>1.5</mu2>
        </ode></friction></surface>
      </collision>
    </link>

    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_right_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
      <pose>-0.775 -0.6 -0.05 0 0 0</pose>
    </joint>

    <link name="rear_right_wheel">
      <inertial>
        <mass>5</mass>
        <inertia><ixx>0.098</ixx><iyy>0.169</iyy><izz>0.098</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="visual"><geometry><cylinder><radius>0.26</radius><length>0.18</length></cylinder></geometry></visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.26</radius><length>0.18</length></cylinder></geometry>
        <surface><friction><ode>
          <mu>1.5</mu>
          <mu2>1.5</mu2>
        </ode></friction></surface>
      </collision>
    </link>


    <!-- ================================================================
         ACKERMANN STEERING SYSTEM PLUGIN
         Values below are placeholders (FS-typical), not real car specs —
         see the chassis inertial block above for the same caveat.
         ================================================================ -->
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <!-- Driven wheels (AWD: both front and rear) -->
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <!-- Steering joints (front axle only) -->
      <left_steering_joint>front_left_wheel_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_wheel_steering_joint</right_steering_joint>

      <kingpin_width>1.2</kingpin_width>       <!-- meters -->
      <wheel_base>1.55</wheel_base>            <!-- meters, front-to-rear axle distance -->
      <wheel_separation>1.2</wheel_separation> <!-- meters, track width -->
      <wheel_radius>0.26</wheel_radius>        <!-- meters -->
      <steering_limit>0.332</steering_limit>   <!-- radians; atan(wheel_base / min_turning_radius),
                                                     here assuming a 4.5m min turning radius -->

      <min_velocity>-5</min_velocity>          <!-- m/s, typically negative for reverse -->
      <max_velocity>20</max_velocity>          <!-- m/s -->
      <min_acceleration>-8</min_acceleration>  <!-- m/s² -->
      <max_acceleration>5</max_acceleration>   <!-- m/s² -->

      <!-- gz-transport topic the control process publishes commands to -->
      <topic>/cmd_ackermann</topic>
    </plugin>

    <!-- Required: broadcasts joint states so the steering works in simulation -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>

  </model>
</sdf>
