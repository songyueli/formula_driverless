<?xml version="1.0" ?>
<!--
  FSD race car model.
  Step 2: basic car with AckermannSteering (no sensors) — drive manually.
  Step 3: add lidar and cameras (sensor blocks are stubbed below).

  All TODO values must be filled in from real car measurements before this
  model will behave correctly. See project brief section 5 & 6.
-->
<sdf version="1.10">
  <model name="fsd_car">

    <!-- ================================================================
         CHASSIS
         TODO: set mass, moments of inertia from real car specs
         ================================================================ -->
    <link name="chassis">
      <inertial>
        <mass>230</mass>           <!-- kg, total vehicle mass (placeholder, FS-typical) -->
        <inertia>
          <ixx>6.52</ixx>          <!-- kg·m², roll -->
          <iyy>63.8</iyy>          <!-- kg·m², pitch -->
          <izz>66.9</izz>          <!-- kg·m², yaw -->
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="chassis_visual">
        <!-- TODO: replace box with a proper mesh once CAD is available -->
        <geometry>
          <!-- width tuned to the real-measured 1.2m total vehicle width:
               wheel_separation=1.02 (center-to-center) below, wheels
               0.18m thick puts each wheel's inner face at 0.42m from
               centerline, so 0.84m keeps the body roughly flush against
               the wheels without reopening a gap. -->
          <box><size>1.8 0.84 0.3</size></box>  <!-- length width height, meters -->
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="chassis_collision">
        <geometry>
          <box><size>1.8 0.84 0.3</size></box>
        </geometry>
      </collision>

      <!-- ================================================================
           SENSORS — lidar + 3 cameras.
           Mounting positions and FOV are placeholders (no real car specs
           yet): lidar centered above the chassis, cameras at the nose
           with left/right yawed ~34° outward from front for peripheral
           coverage. horizontal_fov is 45° (0.7854 rad) on all 3 cameras.
           ================================================================ -->

      <sensor name="os1_128" type="gpu_lidar">
        <!-- Raised from the original 0.35 -- that put it below chassis/nose
             height, giving it a shallow grazing angle onto both the ground
             and any cone at real detection range, which made lidar returns
             that happened to project inside a cone's 2-D bounding box more
             likely to actually be a mismatched ground/occlusion return
             rather than the cone's own surface (see lidar_projector.cpp's
             class comment -- Localize() has no way to tell the difference,
             it just takes whichever in-box point has the smallest range).
             Confirmed directly as a real accuracy problem, not theoretical:
             cross-checking live /estimated_landmarks against Gazebo's own
             real cone positions found a median 1.36m error with a long
             tail past 14m at 0.35. 0.9 (matching the 1.0m camera mount)
             fixed that (median dropped to 0.54m) but was too high in
             practice; 0.6 is the middle-ground settled on. kLidarZ in
             lidar_projector.cpp MUST be kept in sync with this value --
             see that file's class comment. -->
        <pose>0.3 0 0.6 0 0 0</pose>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>1024</samples>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <!-- Restored to 128 (real OS1-128 channel count) -- was reduced
                   to 32 for dev-time render cost before perception consumed
                   this data at all. Now that it does, the tradeoff is
                   reversed: confirmed directly (2026-08-23 ground-truth
                   comparison) that /cone_detections error jumps sharply past
                   ~14m range (median ~0.16-0.26m under 14m vs ~0.9-3.7m
                   beyond it) -- exactly the range where 32 channels' vertical
                   spacing (45deg/32 =~1.4deg, ~0.37m between rings at 15m,
                   comparable to a cone's own 0.325m height) starts leaving a
                   cone's surface hit by only 0/1 rings, well under
                   kMinPointsForDetection=2 (lidar_projector.cpp) or thin
                   enough that a single stray background point can dominate
                   the centroid. 128 channels (45deg/128=~0.35deg, ~0.09m
                   spacing at 15m) puts several rings on even a far cone. -->
              <samples>128</samples>
              <min_angle>-0.3927</min_angle>
              <max_angle>0.3927</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.3</min>
            <max>120.0</max>
          </range>
          <noise>
            <type>gaussian</type>
            <stddev>0.008</stddev>
          </noise>
        </lidar>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>/lidar/points</topic>
      </sensor>

      <!-- Camera resolution halved to 720x540 (2026-08-23) to raise the
           whole pipeline's real-time-factor -- update_rate is a SIM-TIME
           rate, so wall-clock camera Hz = update_rate * RTF, and the ~4Hz
           feed the halving was meant to fix was a symptom of RTF sitting
           around 0.15-0.27 under the full pipeline's load, not a
           camera-config problem on its own. A first attempt at this cut
           crashed perception reliably (nv::cuda::RuntimeException --
           cudaErrorIllegalAddress inside vpiCreateRemap()) at both 720x540
           and 640x480, which first looked like a resolution/alignment
           problem but was root-caused (via CUDA_LAUNCH_BLOCKING=1 + gdb
           backtrace, then a diagnostic print of the exact failing rect) to
           a real VPI bug: camera_stitcher.cpp was cropping each camera's
           warp map to a REQUESTED rect whose width/height weren't
           multiples of 16 (e.g. 591x539), which VPI's vpiCreateRemap()
           doesn't handle safely -- fixed there by padding that rect up to
           16-pixel alignment before use (see that file's comment). RTF
           itself turned out to be dominated by something else entirely:
           the Jetson's GPU was stuck at its minimum clock (306 of
           1300 MHz) after a reboot until `jetson_clocks` was reapplied --
           doing so alone raised RTF from ~0.12 to ~0.31, a far bigger
           lever than resolution. Lidar (128-channel gpu_lidar, see below)
           and a coarser 2ms physics step were both tested as further RTF
           levers and ruled out/reverted: lidar wasn't a meaningful cost
           (RTF unchanged with it fully disabled), and while 2ms physics
           did push RTF to ~0.54, it broke this morning's localization
           accuracy fix badly (landmark 1st-seen error median 0.618m
           against the <=0.20m requirement, 84.7% over) -- reverted to the
           original 1ms step. Net result: ~9.3-9.6Hz per camera at RTF
           ~0.31-0.32, 1ms physics, accuracy intact. -->
      <sensor name="camera_front" type="camera">
        <pose>0.9 0 1.0 0 0.3 0</pose>  <!-- 1m up, pitched down ~17 deg -->
        <update_rate>30</update_rate>
        <camera>
          <image>
            <width>720</width>
            <height>540</height>
          </image>
          <horizontal_fov>0.7854</horizontal_fov>  <!-- 45 deg -->
        </camera>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>/camera/front/image</topic>
      </sensor>

      <!-- Yaw widened from 0.6 to 0.68 rad (2026-08-23, direct user
           request to reduce camera overlap and see more) -- reduces the
           front/side overlap from ~10.6deg to ~6.0deg of each camera's own
           45deg FOV, and widens the combined raw 3-camera coverage from
           ~113.8deg to ~122.9deg. Must stay < the 45deg (0.7854 rad) HFOV
           itself, or the cameras would have a genuine gap between them
           with no coverage at all -- 0.68 rad (38.97 deg) leaves 6.04deg
           of margin below that ceiling. Must stay in sync with
           perception.cpp's kCamYawLeftRad/kCamYawRightRad, and with
           kPanoWidth/kPanoHeight there (both derived from this angle --
           see that file's own comment for the exact formulas). Confirmed
           directly NOT implicated in the resolution-change crash
           described above -- tested at both the original and this new
           angle, crossed with both the original and reduced resolution,
           and only the resolution ever correlated with the crash. -->
      <sensor name="camera_left" type="camera">
        <pose>0.9 0 1.0 0 0.3 0.68</pose>  <!-- 1m up, pitched down ~17 deg, yawed ~39 deg left -->
        <update_rate>30</update_rate>
        <camera>
          <image>
            <width>720</width>
            <height>540</height>
          </image>
          <horizontal_fov>0.7854</horizontal_fov>  <!-- 45 deg -->
        </camera>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>/camera/left/image</topic>
      </sensor>

      <sensor name="camera_right" type="camera">
        <pose>0.9 0 1.0 0 0.3 -0.68</pose>  <!-- 1m up, pitched down ~17 deg, yawed ~39 deg right -->
        <update_rate>30</update_rate>
        <camera>
          <image>
            <width>720</width>
            <height>540</height>
          </image>
          <horizontal_fov>0.7854</horizontal_fov>  <!-- 45 deg -->
        </camera>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>/camera/right/image</topic>
      </sensor>

      <!-- ================================================================
           INS/GNSS: emulates a VectorNav VN-300 (dual-antenna GNSS/INS).
           A real VN-300 outputs an already internally-fused position/
           velocity/attitude solution, but this exposes the RAW component
           sensors (2x GNSS antenna, 1x IMU) that unit contains rather than
           a magic pre-fused output, since the whole point of this project
           is to fuse them ourselves in localization/. Mount positions are
           placeholders (roof/hoop-height antennas, IMU near CG) pending
           real measurements, same caveat as everything else in this file.

           GNSS noise assumes RTK-corrected fixes: VN-300's own datasheet
           only publishes standalone/SBAS accuracy (1.0m/1.5m horizontal/
           vertical); RTK Fixed accuracy isn't vendor-specific (it's set by
           carrier-phase differential GPS itself), so this uses the
           standard RTK Fixed figures (~1cm horizontal, ~2cm vertical).

           position_sensing/horizontal's <stddev> is in DEGREES, not
           meters, despite navsat.sdf's own schema doc saying "in units of
           meters"; confirmed empirically (not guessed): with 0.01 there,
           a stationary car's reported latitude jittered by up to 0.005deg
           (~600m!) between samples, while altitude (position_sensing/
           vertical, genuinely meters-native) stayed within ~1cm of
           correct the whole time. The noise is evidently applied directly
           to the output field (latitude_deg, a raw double), not converted
           through the local-to-global meters-per-degree transform first.
           So 1.07e-7 below is 0.01m converted to degrees by hand, using
           ~93480 m/deg (longitude's tighter conversion at this latitude,
           slightly conservative vs. latitude's ~111320 m/deg); there's
           only one shared horizontal noise value for both lat and lon, so
           this can't be tuned separately per axis anyway.
           Velocity accuracy (<0.05 m/s) and the 1m antenna baseline (which
           the VN-300 heading-accuracy spec of 0.15-0.3 deg is quoted at)
           are both straight from the VN-300 datasheet:
           https://www.vectornav.com/products/detail/vn-300
           IMU noise is also straight from that datasheet: gyro 0.0035
           deg/s/sqrt(Hz) noise density, <5 deg/hr typical in-run bias;
           accel <0.14 mg/sqrt(Hz) noise density, <0.04 mg in-run bias.
           Converted to stddev at this sensor's 400 Hz update rate (density
           * sqrt(rate)); bias figures are modeled as a single per-run
           constant draw (bias_stddev), not a full random-walk process;
           noise.sdf supports that too (dynamic_bias_stddev/
           dynamic_bias_correlation_time) but wasn't worth the extra
           complexity here.
           ================================================================ -->

      <sensor name="gnss_front" type="navsat">
        <pose>0.5 0 0.5 0 0 0</pose>  <!-- front antenna, 1m baseline from gnss_rear -->
        <update_rate>400</update_rate>
        <navsat>
          <position_sensing>
            <horizontal><noise type="gaussian"><stddev>1.07e-7</stddev></noise></horizontal>
            <vertical><noise type="gaussian"><stddev>0.02</stddev></noise></vertical>
          </position_sensing>
          <velocity_sensing>
            <horizontal><noise type="gaussian"><stddev>0.05</stddev></noise></horizontal>
            <vertical><noise type="gaussian"><stddev>0.05</stddev></noise></vertical>
          </velocity_sensing>
        </navsat>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>/gnss/front</topic>
      </sensor>

      <sensor name="gnss_rear" type="navsat">
        <pose>-0.5 0 0.5 0 0 0</pose>  <!-- rear antenna, 1m baseline from gnss_front -->
        <update_rate>400</update_rate>
        <navsat>
          <position_sensing>
            <horizontal><noise type="gaussian"><stddev>1.07e-7</stddev></noise></horizontal>
            <vertical><noise type="gaussian"><stddev>0.02</stddev></noise></vertical>
          </position_sensing>
          <velocity_sensing>
            <horizontal><noise type="gaussian"><stddev>0.05</stddev></noise></horizontal>
            <vertical><noise type="gaussian"><stddev>0.05</stddev></noise></vertical>
          </velocity_sensing>
        </navsat>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>/gnss/rear</topic>
      </sensor>

      <sensor name="imu" type="imu">
        <pose>0 0 0.05 0 0 0</pose>  <!-- near CG -->
        <update_rate>400</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><stddev>0.0012</stddev><bias_stddev>0.000024</bias_stddev></noise></x>
            <y><noise type="gaussian"><stddev>0.0012</stddev><bias_stddev>0.000024</bias_stddev></noise></y>
            <z><noise type="gaussian"><stddev>0.0012</stddev><bias_stddev>0.000024</bias_stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><stddev>0.0275</stddev><bias_stddev>0.00039</bias_stddev></noise></x>
            <y><noise type="gaussian"><stddev>0.0275</stddev><bias_stddev>0.00039</bias_stddev></noise></y>
            <z><noise type="gaussian"><stddev>0.0275</stddev><bias_stddev>0.00039</bias_stddev></noise></z>
          </linear_acceleration>
        </imu>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>/imu</topic>
      </sensor>

    </link> <!-- chassis -->


    <!-- ================================================================
         WHEELS — 4x (AWD, Ackermann front steering)
         ================================================================ -->

    <!-- ================================================================
         FRONT WHEELS — steering knuckle (steer, about z) + wheel (spin, about y).
         Two DOF per front wheel needs an intermediate body between the
         steering joint and the spin joint; a single link can't have both.
         ================================================================ -->

    <!-- Front-left -->
    <joint name="front_left_wheel_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_left_steering_knuckle</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.332</lower>   <!-- negative of steering_limit, radians -->
          <upper>0.332</upper>    <!-- steering_limit, radians -->
          <effort>1e6</effort>    <!-- DART only enforces position limits under
                                        velocity control if an effort limit is set -->
        </limit>
        <!-- Joint damping, added 2026-09-08 (user report: "we're
             oscillating the steering", "the overcorrection is so high" --
             traced to the ROOT, not just retuned around: steer_p_gain=100
             below is a P-ONLY position controller acting on this joint,
             which previously had NO damping specified at all, and the
             child knuckle link's own rotational inertia about this axis is
             tiny (izz=0.001 kg*m^2, see front_left_steering_knuckle's own
             <inertial>). A stiff P-only gain on a near-zero-inertia,
             zero-damping joint is a textbook overshoot-and-ring setup --
             confirmed as the likely real mechanism by a live rollover with
             NO cone within 4m of the car (ruling out a path/planning
             cause; a cone-free flip points at the vehicle's own dynamics
             going unstable). Critical damping for this joint's own inertia
             against steer_p_gain=100 works out to
             2*sqrt(k*I)=2*sqrt(100*0.001)~=0.63 -- 0.8 is deliberately a
             bit ABOVE that (favors killing the ring over minimizing
             settling time, since eliminating oscillation is the whole
             point here). First, not yet live-validated value -- retest at
             the hairpin and watch joint response directly (a joint_state
             publisher isn't currently enabled; add one if this needs
             finer tuning) before trusting it further.

             LOWERED 0.8 -> 0.5, then REVERTED BACK TO 0.8 within the same
             session (2026-09-09). The 0.5 attempt was grounded in real
             [STEER]-trace data (see visualization/src/foxglove_bridge.cpp's
             own commanded-vs-actual instrumentation, added this same
             session specifically to measure this joint's response
             directly): steer_p_gain had been separately lowered 100 -> 40
             on an earlier day without this damping value ever being
             re-derived for the new gain (critical damping is
             gain-dependent, c_crit=2*sqrt(k*I) -- at k=40 that's 0.4, so
             the leftover 0.8 was running at 2x ITS OWN critical damping,
             not the ~1.27x-of-critical margin originally intended),
             and the trace showed a real, measured LAG signature (1.47deg
             mean steering error, transients up to 5-6deg) consistent with
             that mismatch. 0.5 was the mathematically-matched fix
             (0.5/0.4=1.25, restoring the same margin ratio as the
             original 0.8/0.63=1.27) -- but confirmed live, it caused a
             genuine ROLLOVER (roll angle measured at ~180 degrees from a
             live /world/.../pose/info capture) within under two minutes of
             driving, no cone contact involved -- the exact failure mode
             this damping mechanism was introduced to prevent in the first
             place. The joint-level critical-damping formula only models
             this ONE joint in isolation; it doesn't capture the full
             vehicle's own lateral dynamics response to a more responsive
             front axle, which is evidently the dominant effect here, not
             the joint's own local ringing. Reverted to the
             previously-validated 0.8 (4 consecutive clean laps, zero STUCK
             events, before this retune) -- a real, confirmed lag is a far
             safer failure mode to live with than a confirmed rollover.
             Resolving the lag properly needs retuning against the
             VEHICLE's actual dynamics response (e.g. sweeping damping in
             smaller steps while watching for rollover onset, or a
             different controller structure entirely), not a bigger jump
             from a joint-only model -- do not retry 0.5 (or lower) without
             new evidence specifically addressing the rollover mechanism
             found here. -->
        <dynamics>
          <damping>0.8</damping>
        </dynamics>
      </axis>
    </joint>

    <link name="front_left_steering_knuckle">
      <!-- A joint's own pose only places the JOINT FRAME relative to its
           child link; it does NOT relocate the child link itself. The
           link needs its own pose (relative to the model) to actually
           sit where the wheel belongs; this was previously only set on the
           joint, so every wheel link defaulted to the model origin and sat
           collapsed inside the chassis. -->
      <pose>0.775 0.51 -0.05 0 0 0</pose>
      <inertial>
        <mass>1</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
    </link>

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steering_knuckle</parent>
      <child>front_left_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>

    <link name="front_left_wheel">
      <!-- No additional offset from the steering knuckle; same position. -->
      <pose>0.775 0.51 -0.05 0 0 0</pose>
      <inertial>
        <mass>5</mass>
        <inertia><ixx>0.098</ixx><iyy>0.169</iyy><izz>0.098</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <!-- A bare cylinder's symmetry axis defaults to the link's local Z
           (vertical), i.e. an upright can, not a wheel. Rolling 90deg here
           (on the visual/collision only, NOT the link's own pose) lays it
           on its side so the axis matches the wheel joint's Y spin axis,
           without disturbing how that joint's axis gets interpreted
           (which is relative to the link's own, unrotated, frame). -->
      <visual name="visual"><pose>0 0 0 1.570796 0 0</pose><geometry><cylinder><radius>0.26</radius><length>0.18</length></cylinder></geometry></visual>
      <collision name="collision">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry><cylinder><radius>0.26</radius><length>0.18</length></cylinder></geometry>
        <surface><friction><ode>
          <mu>1.5</mu>    <!-- longitudinal grip -->
          <mu2>1.5</mu2>  <!-- lateral grip -->
          <!-- Without fdir1, ODE/DART picks the mu/mu2 split from contact
               geometry, not guaranteed aligned to this wheel's actual
               rolling axis -- the "longitudinal"/"lateral" labels above
               weren't actually being enforced (2026-09-03 finding, user
               request: "check the simulation parameters for the tires").
               "1 0 0" here is in the COLLISION's own local frame (rotated
               90deg about X from the link frame, see this collision's own
               <pose> above) -- since that rotation is about X itself, a
               vector along X is invariant under it, so "1 0 0" here equals
               "1 0 0" (forward) in the unrotated link frame too, no extra
               transform needed. For front wheels this link frame rotates
               WITH the steering knuckle, so this stays the wheel's own
               rolling direction as it steers, not a fixed vehicle-forward
               vector. Not yet live-validated. -->
          <fdir1>1 0 0</fdir1>
        </ode></friction></surface>
      </collision>
    </link>

    <!-- Front-right (mirror of front-left, y flipped) -->
    <joint name="front_right_wheel_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_right_steering_knuckle</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.332</lower>
          <upper>0.332</upper>
          <effort>1e6</effort>
        </limit>
        <!-- Mirror of front_left_wheel_steering_joint's own damping -- see
             its comment for the full reasoning (0.5 was tried and reverted
             back to 0.8 the same session after a confirmed live rollover
             -- do not retry a lower value without new evidence). -->
        <dynamics>
          <damping>0.8</damping>
        </dynamics>
      </axis>
    </joint>

    <link name="front_right_steering_knuckle">
      <pose>0.775 -0.51 -0.05 0 0 0</pose>
      <inertial>
        <mass>1</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
    </link>

    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steering_knuckle</parent>
      <child>front_right_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>

    <link name="front_right_wheel">
      <pose>0.775 -0.51 -0.05 0 0 0</pose>
      <inertial>
        <mass>5</mass>
        <inertia><ixx>0.098</ixx><iyy>0.169</iyy><izz>0.098</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <!-- A bare cylinder's symmetry axis defaults to the link's local Z
           (vertical), i.e. an upright can, not a wheel. Rolling 90deg here
           (on the visual/collision only, NOT the link's own pose) lays it
           on its side so the axis matches the wheel joint's Y spin axis,
           without disturbing how that joint's axis gets interpreted
           (which is relative to the link's own, unrotated, frame). -->
      <visual name="visual"><pose>0 0 0 1.570796 0 0</pose><geometry><cylinder><radius>0.26</radius><length>0.18</length></cylinder></geometry></visual>
      <collision name="collision">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry><cylinder><radius>0.26</radius><length>0.18</length></cylinder></geometry>
        <surface><friction><ode>
          <mu>1.5</mu>
          <mu2>1.5</mu2>
          <!-- See front_left_wheel's collision block above for why "1 0 0"
               here (this collision's own local frame) is correct without
               further transform, and why it stays valid under steering. -->
          <fdir1>1 0 0</fdir1>
        </ode></friction></surface>
      </collision>
    </link>

    <!-- ================================================================
         REAR WHEELS — spin only (no steering), attach straight to chassis.
         ================================================================ -->

    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_left_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>

    <link name="rear_left_wheel">
      <pose>-0.775 0.51 -0.05 0 0 0</pose>
      <inertial>
        <mass>5</mass>
        <inertia><ixx>0.098</ixx><iyy>0.169</iyy><izz>0.098</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <!-- A bare cylinder's symmetry axis defaults to the link's local Z
           (vertical), i.e. an upright can, not a wheel. Rolling 90deg here
           (on the visual/collision only, NOT the link's own pose) lays it
           on its side so the axis matches the wheel joint's Y spin axis,
           without disturbing how that joint's axis gets interpreted
           (which is relative to the link's own, unrotated, frame). -->
      <visual name="visual"><pose>0 0 0 1.570796 0 0</pose><geometry><cylinder><radius>0.26</radius><length>0.18</length></cylinder></geometry></visual>
      <collision name="collision">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry><cylinder><radius>0.26</radius><length>0.18</length></cylinder></geometry>
        <surface><friction><ode>
          <mu>1.5</mu>
          <mu2>1.5</mu2>
          <!-- See front_left_wheel's collision block above for why "1 0 0"
               here (this collision's own local frame) is correct without
               further transform, and why it stays valid under steering. -->
          <fdir1>1 0 0</fdir1>
        </ode></friction></surface>
      </collision>
    </link>

    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_right_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>

    <link name="rear_right_wheel">
      <pose>-0.775 -0.51 -0.05 0 0 0</pose>
      <inertial>
        <mass>5</mass>
        <inertia><ixx>0.098</ixx><iyy>0.169</iyy><izz>0.098</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <!-- A bare cylinder's symmetry axis defaults to the link's local Z
           (vertical), i.e. an upright can, not a wheel. Rolling 90deg here
           (on the visual/collision only, NOT the link's own pose) lays it
           on its side so the axis matches the wheel joint's Y spin axis,
           without disturbing how that joint's axis gets interpreted
           (which is relative to the link's own, unrotated, frame). -->
      <visual name="visual"><pose>0 0 0 1.570796 0 0</pose><geometry><cylinder><radius>0.26</radius><length>0.18</length></cylinder></geometry></visual>
      <collision name="collision">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry><cylinder><radius>0.26</radius><length>0.18</length></cylinder></geometry>
        <surface><friction><ode>
          <mu>1.5</mu>
          <mu2>1.5</mu2>
          <!-- See front_left_wheel's collision block above for why "1 0 0"
               here (this collision's own local frame) is correct without
               further transform, and why it stays valid under steering. -->
          <fdir1>1 0 0</fdir1>
        </ode></friction></surface>
      </collision>
    </link>


    <!-- ================================================================
         ACKERMANN STEERING SYSTEM PLUGIN
         Values below are placeholders (FS-typical), not real car specs —
         see the chassis inertial block above for the same caveat.
         ================================================================ -->
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <!-- Driven wheels (AWD: both front and rear) -->
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <!-- Steering joints (front axle only) -->
      <left_steering_joint>front_left_wheel_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_wheel_steering_joint</right_steering_joint>

      <!-- 1.02m center-to-center: real-measured 1.2m total vehicle width
           (outer wheel face to outer wheel face) minus one 0.18m wheel
           thickness (see the wheel links' visual/collision geometry
           above), since wheel_separation/kingpin_width are the distance
           between wheel CENTERS, not the vehicle's outer envelope. -->
      <kingpin_width>1.02</kingpin_width>       <!-- meters -->
      <wheel_base>1.55</wheel_base>             <!-- meters, front-to-rear axle distance -->
      <wheel_separation>1.02</wheel_separation> <!-- meters, track width -->
      <wheel_radius>0.26</wheel_radius>        <!-- meters -->
      <steering_limit>0.332</steering_limit>   <!-- radians; atan(wheel_base / min_turning_radius),
                                                     here assuming a 4.5m min turning radius -->

      <!-- P-gain for the steering joints' own internal position
           controller -- undocumented (not shown in gz-sim's own example
           ackermann_steering.sdf world, not previously set here at all, so
           this plugin was running on WHATEVER internal default it falls
           back to when the tag is absent). Added 2026-08-31 after a user-
           reported "steering feels laggy, oscillating around the planned
           path" symptom: confirmed directly via a live joint_state trace
           earlier this session that a HELD, constant steering command took
           1.5-2+ seconds to ramp from ~0.05 to ~0.07 rad -- a genuinely
           soft, slow-converging response, not the near-instant tracking
           pure pursuit's own geometry assumes (it re-derives a fresh
           target curvature every cycle with no compensation for the
           steering actuator lagging behind it). 100 was a first,
           untested-live retry at a much stiffer response -- the comment
           at the time explicitly flagged "watch for the opposite failure
           mode (overshoot/oscillation from TOO stiff a gain)" but that
           re-validation never happened.
           LOWERED 100 -> 40 (2026-09-08, user report: "we're oscillating
           the steering... why is the overcorrection so high" -- exactly
           the flagged-but-never-checked failure mode, confirmed live via a
           cone-free rollover (no cone within 4m, pointing at the vehicle's
           own dynamics rather than a path/planning cause). Paired with the
           steering joints' own axis dynamics damping (see their own
           comment, added the same day) rather than relying on the P-gain
           alone to avoid ringing -- a properly damped joint can stay
           reasonably responsive at a more moderate gain instead of needing
           either "too soft" or "too stiff" as the only two data points.
           First, not yet live-validated value for THIS combination (gain
           + damping together) -- retest at the hairpin specifically. -->
      <steer_p_gain>40</steer_p_gain>

      <min_velocity>-5</min_velocity>          <!-- m/s, typically negative for reverse -->
      <max_velocity>20</max_velocity>          <!-- m/s -->
      <min_acceleration>-8</min_acceleration>  <!-- m/s² -->
      <!-- RAISED 5 -> 9.81 (2026-09-04, user request: "increase the
           acceleration to 1 g"). 9.81 m/s^2 = 1.0g. Well within the sim's
           own tire model (mu=1.5, see this file's own wheel collision
           blocks -- theoretical max ~14.7 m/s^2/1.5g), so this isn't
           asking the plugin to demand more forward grip than the tires
           could plausibly deliver. Left min_acceleration (braking) at -8
           unchanged -- not part of this request, and already closer to
           1g (0.82g) than max_acceleration was. This governs how fast the
           SIM PHYSICS can actually change the car's speed toward whatever
           pure_pursuit_controller.cpp commands -- raising it doesn't
           change what speed gets commanded, just how quickly the real
           vehicle can catch up to a commanded increase. Not yet live-
           validated. -->
      <max_acceleration>9.81</max_acceleration>   <!-- m/s² (1.0g) -->

      <!-- gz-transport topic the control process publishes commands to -->
      <topic>/cmd_ackermann</topic>
    </plugin>

    <!-- Required: broadcasts joint states so the steering works in simulation -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>

    <!-- ================================================================
         GROUND SPEED SENSOR: emulates a Sensoric OMS Race, a non-contact
         optical sensor that measures true ground velocity (longitudinal +
         lateral only, no vertical, since it's a biaxial sensor) directly
         off the road surface, independent of wheel slip. gz-sim has no
         dedicated "ground speed sensor" type, so this uses the generic
         OdometryPublisher system plugin instead, which reads the model's
         actual physics-engine velocity (as opposed to AckermannSteering's
         own /model/fsd_car/odometry above, which is wheel-kinematic
         ESTIMATED velocity, not measured), mechanically the closest
         match to what a non-contact optical sensor is approximating.
         Specs from https://www.sensoric-solutions.com/ : 1kHz update
         rate, 0.1% speed accuracy (converted to an absolute stddev
         assuming a representative ~20 m/s FSAE dynamic-event speed, since
         gz's noise model needs an absolute value, not a percentage).
         ================================================================ -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <dimensions>2</dimensions>
      <odom_frame>fsd_car/ground_speed_odom</odom_frame>
      <robot_base_frame>fsd_car/chassis</robot_base_frame>
      <odom_publish_frequency>1000</odom_publish_frequency>
      <odom_topic>/ground_speed</odom_topic>
      <gaussian_noise>0.02</gaussian_noise>
    </plugin>

  </model>
</sdf>
