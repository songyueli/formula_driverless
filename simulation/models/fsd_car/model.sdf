<?xml version="1.0" ?>
<!--
  FSD race car model.
  Step 2: basic car with AckermannSteering (no sensors) — drive manually.
  Step 3: add lidar and cameras (sensor blocks are stubbed below).

  All TODO values must be filled in from real car measurements before this
  model will behave correctly. See project brief section 5 & 6.
-->
<sdf version="1.10">
  <model name="fsd_car">

    <!-- ================================================================
         CHASSIS
         TODO: set mass, moments of inertia from real car specs
         ================================================================ -->
    <link name="chassis">
      <inertial>
        <mass>230</mass>           <!-- kg, total vehicle mass (placeholder, FS-typical) -->
        <inertia>
          <ixx>6.52</ixx>          <!-- kg·m², roll -->
          <iyy>63.8</iyy>          <!-- kg·m², pitch -->
          <izz>66.9</izz>          <!-- kg·m², yaw -->
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="chassis_visual">
        <!-- TODO: replace box with a proper mesh once CAD is available -->
        <geometry>
          <!-- width tuned to the real-measured 1.2m total vehicle width:
               wheel_separation=1.02 (center-to-center) below, wheels
               0.18m thick puts each wheel's inner face at 0.42m from
               centerline, so 0.84m keeps the body roughly flush against
               the wheels without reopening a gap. -->
          <box><size>1.8 0.84 0.3</size></box>  <!-- length width height, meters -->
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="chassis_collision">
        <geometry>
          <box><size>1.8 0.84 0.3</size></box>
        </geometry>
      </collision>

      <!-- ================================================================
           SENSORS — lidar + 3 cameras.
           Mounting positions and FOV are placeholders (no real car specs
           yet): lidar centered above the chassis, cameras at the nose
           with left/right yawed ~34° outward from front for peripheral
           coverage. horizontal_fov is 45° (0.7854 rad) on all 3 cameras.
           ================================================================ -->

      <sensor name="os1_128" type="gpu_lidar">
        <pose>0.3 0 0.35 0 0 0</pose>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>1024</samples>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>32</samples>  <!-- reduced from 128 (real OS1-128 channel
                                          count) for dev-time render cost on
                                          software rendering; bump back up once
                                          perception actually consumes this -->
              <min_angle>-0.3927</min_angle>
              <max_angle>0.3927</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.3</min>
            <max>120.0</max>
          </range>
          <noise>
            <type>gaussian</type>
            <stddev>0.008</stddev>
          </noise>
        </lidar>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>/lidar/points</topic>
      </sensor>

      <sensor name="camera_front" type="camera">
        <pose>0.9 0 1.0 0 0.3 0</pose>  <!-- 1m up, pitched down ~17 deg -->
        <update_rate>30</update_rate>
        <camera>
          <image>
            <width>1440</width>
            <height>1080</height>
          </image>
          <horizontal_fov>0.7854</horizontal_fov>  <!-- 45 deg -->
        </camera>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>/camera/front/image</topic>
      </sensor>

      <sensor name="camera_left" type="camera">
        <pose>0.9 0 1.0 0 0.3 0.6</pose>  <!-- 1m up, pitched down ~17 deg, yawed ~34 deg left -->
        <update_rate>30</update_rate>
        <camera>
          <image>
            <width>1440</width>
            <height>1080</height>
          </image>
          <horizontal_fov>0.7854</horizontal_fov>  <!-- 45 deg -->
        </camera>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>/camera/left/image</topic>
      </sensor>

      <sensor name="camera_right" type="camera">
        <pose>0.9 0 1.0 0 0.3 -0.6</pose>  <!-- 1m up, pitched down ~17 deg, yawed ~34 deg right -->
        <update_rate>30</update_rate>
        <camera>
          <image>
            <width>1440</width>
            <height>1080</height>
          </image>
          <horizontal_fov>0.7854</horizontal_fov>  <!-- 45 deg -->
        </camera>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>/camera/right/image</topic>
      </sensor>

      <!-- ================================================================
           INS/GNSS: emulates a VectorNav VN-300 (dual-antenna GNSS/INS).
           A real VN-300 outputs an already internally-fused position/
           velocity/attitude solution, but this exposes the RAW component
           sensors (2x GNSS antenna, 1x IMU) that unit contains rather than
           a magic pre-fused output, since the whole point of this project
           is to fuse them ourselves in localization/. Mount positions are
           placeholders (roof/hoop-height antennas, IMU near CG) pending
           real measurements, same caveat as everything else in this file.

           GNSS noise assumes RTK-corrected fixes: VN-300's own datasheet
           only publishes standalone/SBAS accuracy (1.0m/1.5m horizontal/
           vertical); RTK Fixed accuracy isn't vendor-specific (it's set by
           carrier-phase differential GPS itself), so this uses the
           standard RTK Fixed figures (~1cm horizontal, ~2cm vertical).

           position_sensing/horizontal's <stddev> is in DEGREES, not
           meters, despite navsat.sdf's own schema doc saying "in units of
           meters"; confirmed empirically (not guessed): with 0.01 there,
           a stationary car's reported latitude jittered by up to 0.005deg
           (~600m!) between samples, while altitude (position_sensing/
           vertical, genuinely meters-native) stayed within ~1cm of
           correct the whole time. The noise is evidently applied directly
           to the output field (latitude_deg, a raw double), not converted
           through the local-to-global meters-per-degree transform first.
           So 1.07e-7 below is 0.01m converted to degrees by hand, using
           ~93480 m/deg (longitude's tighter conversion at this latitude,
           slightly conservative vs. latitude's ~111320 m/deg); there's
           only one shared horizontal noise value for both lat and lon, so
           this can't be tuned separately per axis anyway.
           Velocity accuracy (<0.05 m/s) and the 1m antenna baseline (which
           the VN-300 heading-accuracy spec of 0.15-0.3 deg is quoted at)
           are both straight from the VN-300 datasheet:
           https://www.vectornav.com/products/detail/vn-300
           IMU noise is also straight from that datasheet: gyro 0.0035
           deg/s/sqrt(Hz) noise density, <5 deg/hr typical in-run bias;
           accel <0.14 mg/sqrt(Hz) noise density, <0.04 mg in-run bias.
           Converted to stddev at this sensor's 400 Hz update rate (density
           * sqrt(rate)); bias figures are modeled as a single per-run
           constant draw (bias_stddev), not a full random-walk process;
           noise.sdf supports that too (dynamic_bias_stddev/
           dynamic_bias_correlation_time) but wasn't worth the extra
           complexity here.
           ================================================================ -->

      <sensor name="gnss_front" type="navsat">
        <pose>0.5 0 0.5 0 0 0</pose>  <!-- front antenna, 1m baseline from gnss_rear -->
        <update_rate>400</update_rate>
        <navsat>
          <position_sensing>
            <horizontal><noise type="gaussian"><stddev>1.07e-7</stddev></noise></horizontal>
            <vertical><noise type="gaussian"><stddev>0.02</stddev></noise></vertical>
          </position_sensing>
          <velocity_sensing>
            <horizontal><noise type="gaussian"><stddev>0.05</stddev></noise></horizontal>
            <vertical><noise type="gaussian"><stddev>0.05</stddev></noise></vertical>
          </velocity_sensing>
        </navsat>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>/gnss/front</topic>
      </sensor>

      <sensor name="gnss_rear" type="navsat">
        <pose>-0.5 0 0.5 0 0 0</pose>  <!-- rear antenna, 1m baseline from gnss_front -->
        <update_rate>400</update_rate>
        <navsat>
          <position_sensing>
            <horizontal><noise type="gaussian"><stddev>1.07e-7</stddev></noise></horizontal>
            <vertical><noise type="gaussian"><stddev>0.02</stddev></noise></vertical>
          </position_sensing>
          <velocity_sensing>
            <horizontal><noise type="gaussian"><stddev>0.05</stddev></noise></horizontal>
            <vertical><noise type="gaussian"><stddev>0.05</stddev></noise></vertical>
          </velocity_sensing>
        </navsat>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>/gnss/rear</topic>
      </sensor>

      <sensor name="imu" type="imu">
        <pose>0 0 0.05 0 0 0</pose>  <!-- near CG -->
        <update_rate>400</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><stddev>0.0012</stddev><bias_stddev>0.000024</bias_stddev></noise></x>
            <y><noise type="gaussian"><stddev>0.0012</stddev><bias_stddev>0.000024</bias_stddev></noise></y>
            <z><noise type="gaussian"><stddev>0.0012</stddev><bias_stddev>0.000024</bias_stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><stddev>0.0275</stddev><bias_stddev>0.00039</bias_stddev></noise></x>
            <y><noise type="gaussian"><stddev>0.0275</stddev><bias_stddev>0.00039</bias_stddev></noise></y>
            <z><noise type="gaussian"><stddev>0.0275</stddev><bias_stddev>0.00039</bias_stddev></noise></z>
          </linear_acceleration>
        </imu>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>/imu</topic>
      </sensor>

    </link> <!-- chassis -->


    <!-- ================================================================
         WHEELS — 4x (AWD, Ackermann front steering)
         ================================================================ -->

    <!-- ================================================================
         FRONT WHEELS — steering knuckle (steer, about z) + wheel (spin, about y).
         Two DOF per front wheel needs an intermediate body between the
         steering joint and the spin joint; a single link can't have both.
         ================================================================ -->

    <!-- Front-left -->
    <joint name="front_left_wheel_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_left_steering_knuckle</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.332</lower>   <!-- negative of steering_limit, radians -->
          <upper>0.332</upper>    <!-- steering_limit, radians -->
          <effort>1e6</effort>    <!-- DART only enforces position limits under
                                        velocity control if an effort limit is set -->
        </limit>
      </axis>
    </joint>

    <link name="front_left_steering_knuckle">
      <!-- A joint's own pose only places the JOINT FRAME relative to its
           child link; it does NOT relocate the child link itself. The
           link needs its own pose (relative to the model) to actually
           sit where the wheel belongs; this was previously only set on the
           joint, so every wheel link defaulted to the model origin and sat
           collapsed inside the chassis. -->
      <pose>0.775 0.51 -0.05 0 0 0</pose>
      <inertial>
        <mass>1</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
    </link>

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steering_knuckle</parent>
      <child>front_left_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>

    <link name="front_left_wheel">
      <!-- No additional offset from the steering knuckle; same position. -->
      <pose>0.775 0.51 -0.05 0 0 0</pose>
      <inertial>
        <mass>5</mass>
        <inertia><ixx>0.098</ixx><iyy>0.169</iyy><izz>0.098</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <!-- A bare cylinder's symmetry axis defaults to the link's local Z
           (vertical), i.e. an upright can, not a wheel. Rolling 90deg here
           (on the visual/collision only, NOT the link's own pose) lays it
           on its side so the axis matches the wheel joint's Y spin axis,
           without disturbing how that joint's axis gets interpreted
           (which is relative to the link's own, unrotated, frame). -->
      <visual name="visual"><pose>0 0 0 1.570796 0 0</pose><geometry><cylinder><radius>0.26</radius><length>0.18</length></cylinder></geometry></visual>
      <collision name="collision">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry><cylinder><radius>0.26</radius><length>0.18</length></cylinder></geometry>
        <surface><friction><ode>
          <mu>1.5</mu>    <!-- longitudinal grip -->
          <mu2>1.5</mu2>  <!-- lateral grip -->
        </ode></friction></surface>
      </collision>
    </link>

    <!-- Front-right (mirror of front-left, y flipped) -->
    <joint name="front_right_wheel_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_right_steering_knuckle</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.332</lower>
          <upper>0.332</upper>
          <effort>1e6</effort>
        </limit>
      </axis>
    </joint>

    <link name="front_right_steering_knuckle">
      <pose>0.775 -0.51 -0.05 0 0 0</pose>
      <inertial>
        <mass>1</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
    </link>

    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steering_knuckle</parent>
      <child>front_right_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>

    <link name="front_right_wheel">
      <pose>0.775 -0.51 -0.05 0 0 0</pose>
      <inertial>
        <mass>5</mass>
        <inertia><ixx>0.098</ixx><iyy>0.169</iyy><izz>0.098</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <!-- A bare cylinder's symmetry axis defaults to the link's local Z
           (vertical), i.e. an upright can, not a wheel. Rolling 90deg here
           (on the visual/collision only, NOT the link's own pose) lays it
           on its side so the axis matches the wheel joint's Y spin axis,
           without disturbing how that joint's axis gets interpreted
           (which is relative to the link's own, unrotated, frame). -->
      <visual name="visual"><pose>0 0 0 1.570796 0 0</pose><geometry><cylinder><radius>0.26</radius><length>0.18</length></cylinder></geometry></visual>
      <collision name="collision">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry><cylinder><radius>0.26</radius><length>0.18</length></cylinder></geometry>
        <surface><friction><ode>
          <mu>1.5</mu>
          <mu2>1.5</mu2>
        </ode></friction></surface>
      </collision>
    </link>

    <!-- ================================================================
         REAR WHEELS — spin only (no steering), attach straight to chassis.
         ================================================================ -->

    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_left_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>

    <link name="rear_left_wheel">
      <pose>-0.775 0.51 -0.05 0 0 0</pose>
      <inertial>
        <mass>5</mass>
        <inertia><ixx>0.098</ixx><iyy>0.169</iyy><izz>0.098</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <!-- A bare cylinder's symmetry axis defaults to the link's local Z
           (vertical), i.e. an upright can, not a wheel. Rolling 90deg here
           (on the visual/collision only, NOT the link's own pose) lays it
           on its side so the axis matches the wheel joint's Y spin axis,
           without disturbing how that joint's axis gets interpreted
           (which is relative to the link's own, unrotated, frame). -->
      <visual name="visual"><pose>0 0 0 1.570796 0 0</pose><geometry><cylinder><radius>0.26</radius><length>0.18</length></cylinder></geometry></visual>
      <collision name="collision">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry><cylinder><radius>0.26</radius><length>0.18</length></cylinder></geometry>
        <surface><friction><ode>
          <mu>1.5</mu>
          <mu2>1.5</mu2>
        </ode></friction></surface>
      </collision>
    </link>

    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_right_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>

    <link name="rear_right_wheel">
      <pose>-0.775 -0.51 -0.05 0 0 0</pose>
      <inertial>
        <mass>5</mass>
        <inertia><ixx>0.098</ixx><iyy>0.169</iyy><izz>0.098</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <!-- A bare cylinder's symmetry axis defaults to the link's local Z
           (vertical), i.e. an upright can, not a wheel. Rolling 90deg here
           (on the visual/collision only, NOT the link's own pose) lays it
           on its side so the axis matches the wheel joint's Y spin axis,
           without disturbing how that joint's axis gets interpreted
           (which is relative to the link's own, unrotated, frame). -->
      <visual name="visual"><pose>0 0 0 1.570796 0 0</pose><geometry><cylinder><radius>0.26</radius><length>0.18</length></cylinder></geometry></visual>
      <collision name="collision">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry><cylinder><radius>0.26</radius><length>0.18</length></cylinder></geometry>
        <surface><friction><ode>
          <mu>1.5</mu>
          <mu2>1.5</mu2>
        </ode></friction></surface>
      </collision>
    </link>


    <!-- ================================================================
         ACKERMANN STEERING SYSTEM PLUGIN
         Values below are placeholders (FS-typical), not real car specs —
         see the chassis inertial block above for the same caveat.
         ================================================================ -->
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <!-- Driven wheels (AWD: both front and rear) -->
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <!-- Steering joints (front axle only) -->
      <left_steering_joint>front_left_wheel_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_wheel_steering_joint</right_steering_joint>

      <!-- 1.02m center-to-center: real-measured 1.2m total vehicle width
           (outer wheel face to outer wheel face) minus one 0.18m wheel
           thickness (see the wheel links' visual/collision geometry
           above), since wheel_separation/kingpin_width are the distance
           between wheel CENTERS, not the vehicle's outer envelope. -->
      <kingpin_width>1.02</kingpin_width>       <!-- meters -->
      <wheel_base>1.55</wheel_base>             <!-- meters, front-to-rear axle distance -->
      <wheel_separation>1.02</wheel_separation> <!-- meters, track width -->
      <wheel_radius>0.26</wheel_radius>        <!-- meters -->
      <steering_limit>0.332</steering_limit>   <!-- radians; atan(wheel_base / min_turning_radius),
                                                     here assuming a 4.5m min turning radius -->

      <min_velocity>-5</min_velocity>          <!-- m/s, typically negative for reverse -->
      <max_velocity>20</max_velocity>          <!-- m/s -->
      <min_acceleration>-8</min_acceleration>  <!-- m/s² -->
      <max_acceleration>5</max_acceleration>   <!-- m/s² -->

      <!-- gz-transport topic the control process publishes commands to -->
      <topic>/cmd_ackermann</topic>
    </plugin>

    <!-- Required: broadcasts joint states so the steering works in simulation -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>

    <!-- ================================================================
         GROUND SPEED SENSOR: emulates a Sensoric OMS Race, a non-contact
         optical sensor that measures true ground velocity (longitudinal +
         lateral only, no vertical, since it's a biaxial sensor) directly
         off the road surface, independent of wheel slip. gz-sim has no
         dedicated "ground speed sensor" type, so this uses the generic
         OdometryPublisher system plugin instead, which reads the model's
         actual physics-engine velocity (as opposed to AckermannSteering's
         own /model/fsd_car/odometry above, which is wheel-kinematic
         ESTIMATED velocity, not measured), mechanically the closest
         match to what a non-contact optical sensor is approximating.
         Specs from https://www.sensoric-solutions.com/ : 1kHz update
         rate, 0.1% speed accuracy (converted to an absolute stddev
         assuming a representative ~20 m/s FSAE dynamic-event speed, since
         gz's noise model needs an absolute value, not a percentage).
         ================================================================ -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <dimensions>2</dimensions>
      <odom_frame>fsd_car/ground_speed_odom</odom_frame>
      <robot_base_frame>fsd_car/chassis</robot_base_frame>
      <odom_publish_frequency>1000</odom_publish_frequency>
      <odom_topic>/ground_speed</odom_topic>
      <gaussian_noise>0.02</gaussian_noise>
    </plugin>

  </model>
</sdf>
