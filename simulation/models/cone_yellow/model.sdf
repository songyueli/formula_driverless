<?xml version="1.0" ?>
<!--
  Yellow boundary cone. Same dimensions as cone_blue, different color.
-->
<sdf version="1.11">
  <model name="cone_yellow">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry>
          <cone><radius>0.115</radius><length>0.325</length></cone>
        </geometry>
        <material>
          <ambient>0.9 0.9 0 1</ambient>
          <diffuse>0.9 0.9 0 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cone><radius>0.115</radius><length>0.325</length></cone>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
