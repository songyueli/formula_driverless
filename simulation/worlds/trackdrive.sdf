<?xml version="1.0" ?>
<!--
  FSAE/Formula Student Driverless "Trackdrive" event track, built to the
  official rules (Formula Student Rules 2026, section D8; Driverless
  Specification 2026, section DS1):
    - Closed loop, counterclockwise, straights <= 80m, min track width 3m,
      min turning diameter 9m (radius >= 4.5m)
    - Lap length target 200-500m
    - Named features, each verified by signed turn-angle computation before
      building this file (not just eyeballed):
        * SWEEPER      — one long, large-radius (18m) high-speed turn
        * ESSES        — three alternating-direction turns in quick
                          succession (a flowing S-S section, not just one
                          left-right pair)
        * HAIRPIN      — one tight ~120 deg turn at 4.7m radius, close to
                          the legal minimum (4.5m)
        * DOUBLE APEX  — a compound corner: two turns in the SAME
                          direction but different radii (12m then 5.3m),
                          i.e. a decreasing-radius turn with two distinct
                          apexes, not two opposite-direction kinks
        * CHICANE      — a quick left-right (here right-left) direction
                          reversal
    - Cones: blue = left boundary, yellow = right boundary, big orange =
      start/finish gate; boundary cone spacing is capped so no gap ever
      exceeds the 5m rule (DS 1.1) — per-segment sample counts use ceil(),
      not round(), since round() can undercover a 4-6m segment down to a
      single point and silently blow past the 5m max.
    - Vehicle staged with front wheels 6m ahead of the start line (D 8.3.2)
    - A real run is 10 laps (D 8.3.1) — lap counting is left to your own
      planning/control code, this world just provides the track itself.

  Run with (GZ_SIM_RESOURCE_PATH must include simulation/models):
    export GZ_SIM_RESOURCE_PATH=/workspace/simulation/models
    gz sim -s -r simulation/worlds/trackdrive.sdf
-->
<sdf version="1.11">
  <world name="trackdrive">

    <!-- Physics: DART engine, 1 ms step. Good default for vehicle dynamics. -->
    <physics name="default" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Required Gazebo system plugins -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <!-- Required for camera/lidar sensors to actually initialize and publish
         data — without this, sensor elements in a model are inert. -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- Same requirement as Sensors above, but for the non-rendering IMU
         and NavSat (GNSS) sensors on fsd_car; without these, those
         <sensor> elements are inert too. -->
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system"
            name="gz::sim::systems::NavSat"/>

    <!-- Arbitrary real-world georeference point (San Diego area) so the
         navsat sensors have a lat/lon origin to compute from; not tied
         to any specific real venue, this world's own local coordinates are
         what actually matter for the track layout. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>32.9</latitude_deg>
      <longitude_deg>-117.1</longitude_deg>
      <elevation>100</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- Lighting -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>300 300</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>300 300</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- FSD car, staged 6m behind the start/finish line (D 8.3.2).
         z=0.31 so the wheels (radius 0.26, mounted 0.05 below the chassis
         origin, see fsd_car/model.sdf) rest on the ground instead of
         sinking into it; the old z=0.1 predates fixing the wheel geometry
         and left them ~0.2m interpenetrating the ground plane. -->
    <include>
      <uri>model://fsd_car</uri>
      <pose>54.697 -9.961 0.31 0 0 1.3748</pose>
    </include>

    <!-- ==================== ORANGE — start/finish gate ==================== -->
    <include>
      <uri>model://cone_orange</uri>
      <name>cone_orange_00</name>
      <pose>54.394 -3.784 0.2525 0 0 0</pose>
    </include>
    <include>
      <uri>model://cone_orange</uri>
      <name>cone_orange_01</name>
      <pose>57.337 -4.368 0.2525 0 0 0</pose>
    </include>

    <!-- ==================== BOUNDARY — blue (left) / yellow (right) ==================== -->
    <include>
      <uri>model://cone_blue</uri>
      <name>cone_blue_000</name>
      <pose>55.053 -0.458 0.1625 0 0 0</pose>
    </include>
    <include>
      <uri>model://cone_yellow</uri>
      <name>cone_yellow_000</name>
      <pose>57.996 -1.042 0.1625 0 0 0</pose>
    </include>
    <include>
      <uri>model://cone_blue</uri>
      <name>cone_blue_001</name>
      <pose>55.322 1.489 0.1625 0 0 0</pose>
    </include>
    <include>
      <uri>model://cone_yellow</uri>
      <name>cone_yellow_001</name>
      <pose>58.312 1.259 0.1625 0 0 0</pose>
    </include>
