# CMake build artifacts
build/
install/
*.o
*.a
*.so

# IDE
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/
*.egg-info/

# ML artifacts — large files, track with Git LFS if needed
ml/data/*
!ml/data/.gitkeep
ml/models/
*.pt
*.pth
*.onnx
*.trt
*.engine
.ipynb_checkpoints/

# Training run outputs (metrics, plots, weights) -- the .onnx/.engine model
# formats perception.cpp actually loads are already covered by the *.onnx/
# *.engine rules above; the PyTorch .pt checkpoint is deliberately never
# needed (nothing in this pipeline loads a .pt file at runtime), so nothing
# under here needs a tracked exception anymore.
ml/runs/

# Defensive only -- train.py's project default used to be a bare relative
# "runs/detect", which ultralytics resolved against the CALLING PROCESS's
# CWD rather than train.py's own location, so training invoked from the repo
# root (rather than from within ml/) landed here instead of under ml/runs/.
# Fixed by anchoring train.py's DEFAULT_PROJECT to the script's own file
# location, so nothing should land here anymore -- kept as a safety net in
# case some other invocation still passes a bare relative project path.
runs/

# Gazebo logs and caches
.gz/
*.log

# macOS
.DS_Store
