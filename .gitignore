# CMake build artifacts
build/
install/
*.o
*.a
*.so

# IDE
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/
*.egg-info/

# ML artifacts — large files, track with Git LFS if needed
ml/data/*
!ml/data/.gitkeep
ml/models/
*.pt
*.pth
*.onnx
*.trt
*.engine
.ipynb_checkpoints/

# Training run outputs (metrics, plots, logs) are ignored, except the
# checkpoint below, which is tracked via Git LFS (see .gitattributes).
# Git won't apply a negation to a file inside an ignored directory, so each
# level has to be carved out individually rather than just ignoring ml/runs/.
ml/runs/*
!ml/runs/detect/
ml/runs/detect/*
!ml/runs/detect/train/
ml/runs/detect/train/*
!ml/runs/detect/train/weights/
ml/runs/detect/train/weights/*
!ml/runs/detect/train/weights/best.pt

# Actual training output location (an ultralytics project-path quirk --
# train.py's project="runs/detect" default resolves HERE, at the repo root,
# not under ml/ as the parameter name suggests -- confirmed by inspecting
# the real directory on the machine that ran training, not assumed). Not
# tracked via LFS like ml/runs/detect/train/weights/best.pt above -- that's
# a deliberately-versioned checkpoint; this is untracked scratch output
# (training-batch preview images, metric plots, csvs) from the same run.
runs/

# Gazebo logs and caches
.gz/
*.log

# macOS
.DS_Store
